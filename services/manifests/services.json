{
  "nativeBundles": {
    "sa3": {
      "version": "v0.1.5",
      "platforms": {
        "windows-x64": {
          "core": {
            "url": "https://github.com/betweentwomidnights/sa3.cpp/releases/download/v0.1.5/sa3-v0.1.5-windows-x64-core.zip",
            "sha256": "0791a4c2d469f4609ac68af2703c46356a1899545ecbc1755b6e7d07193f48b8"
          },
          "backends": {
            "cuda": {
              "url": "https://github.com/betweentwomidnights/sa3.cpp/releases/download/v0.1.5/sa3-v0.1.5-windows-x64-cuda.zip",
              "sha256": "360a3da9075e148e693539e9335845fc30aba4f236b95c9c73315ff05ae26861",
              "requires": ["cudart-12.8"]
            },
            "vulkan": {
              "url": "https://github.com/betweentwomidnights/sa3.cpp/releases/download/v0.1.5/sa3-v0.1.5-windows-x64-vulkan.zip",
              "sha256": "9ed1362e2415580fc742918329b0969bafbf4f56981ee7df948abb4fae39d413"
            }
          },
          "prefer": ["cuda", "vulkan"]
        }
      }
    }
  },
  "version": "2.0",
  "services": [
    {
      "id": "gary",
      "displayName": "gary (musicgen)",
      "description": "MusicGen continuation and generation service",
      "port": 8000,
      "entryPoint": "g4l_localhost.py",
      "workingDir": "services/gary",
      "pythonVersion": "3.11",
      "torchVersion": "2.7.1",
      "torchIndex": "https://download.pytorch.org/whl/cu128",
      "torchPackages": ["torch==2.7.1", "torchaudio==2.7.1"],
      "requirementsFile": "requirements.txt",
      "editableInstall": true,
      "editablePackagePath": ".",
      "editableInstallFlags": "--no-deps",
      "xformersShim": true,
      "forceTorchReinstall": true,
      "buildSteps": [
        "pip install torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip install -e . --no-deps",
        "pip install -r requirements.txt",
        "pip install https://github.com/sdbds/flash-attention-for-windows/releases/download/2.8.2/flash_attn-2.8.2+cu128torch2.7.1cxx11abiFALSEfullbackward-cp311-cp311-win_amd64.whl",
        "install_xformers_shim",
        "pip install --force-reinstall --no-deps torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip uninstall torchvision"
      ],
      "healthCheck": {
        "endpoint": "/health",
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "startupGraceSeconds": 60
      },
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONLEGACYWINDOWSSTDIO": "1"
      },
      "dependsOn": []
    },
    {
      "id": "melodyflow",
      "displayName": "terry (melodyflow)",
      "description": "Audio editing and continuation with MelodyFlow",
      "port": 8002,
      "entryPoint": "localhost_melodyflow.py",
      "workingDir": "services/melodyflow",
      "pythonVersion": "3.11",
      "torchVersion": "2.7.1",
      "torchIndex": "https://download.pytorch.org/whl/cu128",
      "torchPackages": ["torch==2.7.1", "torchaudio==2.7.1", "torchvision==0.22.1"],
      "requirementsFile": "requirements.txt",
      "xformersShim": true,
      "forceTorchReinstall": true,
      "buildSteps": [
        "pip install torch==2.7.1 torchaudio==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip install -r requirements.txt",
        "pip install https://github.com/sdbds/flash-attention-for-windows/releases/download/2.8.2/flash_attn-2.8.2+cu128torch2.7.1cxx11abiFALSEfullbackward-cp311-cp311-win_amd64.whl",
        "install_xformers_shim",
        "pip install --force-reinstall --no-deps torch==2.7.1 torchaudio==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128"
      ],
      "healthCheck": {
        "endpoint": "/health",
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "startupGraceSeconds": 90
      },
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONLEGACYWINDOWSSTDIO": "1"
      },
      "dependsOn": []
    },
    {
      "id": "stable-audio",
      "displayName": "jerry (stable audio)",
      "description": "Text-to-audio synthesis with Stable Audio Open Small",
      "port": 8005,
      "entryPoint": "api.py",
      "workingDir": "services/stable-audio",
      "pythonVersion": "3.11",
      "torchVersion": "2.7.1",
      "torchIndex": "https://download.pytorch.org/whl/cu128",
      "torchPackages": ["torch==2.7.1", "torchaudio==2.7.1", "torchvision==0.22.1"],
      "requirementsFile": "requirements.txt",
      "editableInstall": true,
      "editablePackagePath": ".",
      "editableInstallFlags": "--no-deps",
      "forceTorchReinstall": true,
      "buildSteps": [
        "pip install torch==2.7.1 torchaudio==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip install -e . --no-deps",
        "pip install -r requirements.txt",
        "pip install https://github.com/sdbds/flash-attention-for-windows/releases/download/2.8.2/flash_attn-2.8.2+cu128torch2.7.1cxx11abiFALSEfullbackward-cp311-cp311-win_amd64.whl",
        "pip install --force-reinstall --no-deps torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128"
      ],
      "healthCheck": {
        "endpoint": "/health",
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "startupGraceSeconds": 120
      },
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "HF_TOKEN": "${HF_TOKEN}"
      },
      "native": {
        "bundle": "sa3",
        "executable": "sat-server.exe",
        "modelsDir": "stable-audio",
        "args": ["--model", "saos", "--encoding", "f16"],
        "env": {
          "SA3_PORT": "8005",
          "SA3_DEVICE": "${NATIVE_BACKEND}",
          "SA3_MODELS_DIR": "${MODELS_DIR}/stable-audio"
        }
      },
      "migration": {
        "dataDir": "stable-audio",
        "label": "jerry",
        "legacy": {
          "envDirs": ["env", ".venv"],
          "hfRepos": [
            {"repo": "stabilityai/stable-audio-open-small", "label": "PyTorch base model"},
            {"repo": "thepatch/jerry_grunge", "label": "PyTorch Jerry Grunge finetune"},
            {"repo": "S3Sound/kickbass", "label": "PyTorch kickbass finetune"}
          ],
          "code": {
            "files": [
              "LICENSE",
              "README.md",
              "api.py",
              "base_model_config.json",
              "defaults.ini",
              "model_loader_enhanced.py",
              "patch_generation.py",
              "pre_encode.py",
              "pyproject.toml",
              "requirements.lock.txt",
              "requirements.txt",
              "riff_manager.py",
              "setup.py"
            ],
            "packages": ["LICENSES", "riffs", "stable_audio_tools"]
          }
        }
      },
      "dependsOn": []
    },
    {
      "id": "sa3",
      "migration": {
        "dataDir": "sa3",
        "label": "SA3",
        "dataLabel": "LoRAs, prompts, training jobs and checkpoints",
        "legacy": {
          "envDirs": [
            "env",
            ".venv"
          ],
          "hfRepos": [
            {
              "repo": "stabilityai/stable-audio-3-medium",
              "label": "PyTorch inference weights"
            },
            {
              "repo": "stabilityai/stable-audio-3-medium-base",
              "label": "PyTorch training base",
              "role": "training-base"
            }
          ],
          "staged": {
            "dir": "sa3/training/models/sa3-medium/base",
            "label": "staged PyTorch training base",
            "role": "training-base",
            "files": [
              "model_config.json",
              "model.safetensors",
              "t5gemma-b-b-ul2/config.json",
              "t5gemma-b-b-ul2/model.safetensors",
              "t5gemma-b-b-ul2/tokenizer.json",
              "t5gemma-b-b-ul2/tokenizer_config.json"
            ]
          },
          "code": {
            "files": [
              "api.py",
              "analyze_audio.py",
              "bpm_analysis.py",
              "key_analysis.py",
              "build_lora_prompts.py",
              "lora_train.py",
              "lora_train_lightning.py",
              "train_lora_job.py",
              "train_memory.py",
              "setup.py",
              "requirements.txt"
            ],
            "packages": [
              "stable_audio_3",
              "underfit",
              "dataset_processing",
              "tests"
            ]
          }
        }
      },
      "native": {
        "bundle": "sa3",
        "executable": "sa3-server.exe",
        "modelsDir": "sa3",
        "args": ["--model", "medium", "--encoding", "f16", "--t5-encoding", "f16", "--ae-encoding", "f32"],
        "env": {
          "SA3_PORT": "18006",
          "SA3_MAX_DURATION": "446",
          "SA3_DEVICE": "${NATIVE_BACKEND}",
          "SA3_MODELS_DIR": "${MODELS_DIR}/sa3",
          "SA3_ADAPTERS_DIR": "${GARY_RUNTIME}/sa3/native-loras",
          "SA3_SOURCE_LORAS_DIR": "${GARY_RUNTIME}/sa3/loras",
          "SA3_PROMPTS_DIR": "${GARY_RUNTIME}/sa3/prompts"
        }
      },
      "displayName": "sa3 (stable audio 3)",
      "description": "Text-to-audio generation and editing with Stable Audio 3",
      "port": 8006,
      "entryPoint": "api.py",
      "workingDir": "services/sa3",
      "pythonVersion": "3.11",
      "torchVersion": "2.7.1",
      "torchIndex": "https://download.pytorch.org/whl/cu128",
      "torchPackages": ["torch==2.7.1", "torchaudio==2.7.1"],
      "requirementsFile": "requirements.txt",
      "editableInstall": true,
      "editablePackagePath": ".",
      "editableInstallFlags": "--no-deps",
      "forceTorchReinstall": true,
      "buildSteps": [
        "pip install torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip install -e . --no-deps",
        "pip install -r requirements.txt",
        "pip install https://github.com/sdbds/flash-attention-for-windows/releases/download/2.8.2/flash_attn-2.8.2+cu128torch2.7.1cxx11abiFALSEfullbackward-cp311-cp311-win_amd64.whl",
        "pip install --force-reinstall --no-deps torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128"
      ],
      "healthCheck": {
        "endpoint": "/health",
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "startupGraceSeconds": 30
      },
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "HF_TOKEN": "${HF_TOKEN}",
        "SA3_MODEL": "medium",
        "SA3_PROMPTS_DIR": "${GARY_RUNTIME}/sa3/prompts",
        "SA3_LORA_REGISTRY": "${GARY_RUNTIME}/sa3/lora_registry.json",
        "SA3_LORA_DIR": "${GARY_RUNTIME}/sa3/loras",
        "SA3_PEAK_NORMALIZE_DB": "2.0",
        "SA3_LIMITER_CEILING_DB": "-0.3",
        "SA3_LIMITER_KNEE": "0.8",
        "SA3_LATENT_RESCALE": "1.0",
        "SA3_LATENT_SHIFT": "0.0",
        "SA3_LATENT_TARGET_STD": "",
        "SA3_LATENT_ADAPT_MIN": "0.9",
        "SA3_LATENT_ADAPT_MAX": "1.0",
        "SA3_TAIL_PAD_SECONDS": "6",
        "SA3_CONTINUE_TAIL_MODE": "regen_past",
        "SA3_CONTINUE_TAIL_PAD": "6",
        "SA3_CONTINUE_SPLICE_SOURCE": "1",
        "SA3_CONTINUE_SPLICE_XFADE": "0.03",
        "SA3_CONTINUE_SPLICE_GAIN_MATCH": "1",
        "SA3_CONTINUE_MASK_OVERLAP": "0.2",
        "SA3_LATENT_DIAG": "0",
        "OUTPUT_DIR": "${GARY_RUNTIME}/sa3/outputs"
      },
      "dependsOn": []
    },
    {
      "id": "carey",
      "displayName": "carey (ace-step 1.5)",
      "description": "Stem generation (lego), continuation (complete), and remix (cover) with ACE-Step",
      "port": 8003,
      "entryPoint": "carey_wrapper.py",
      "workingDir": "services/carey",
      "pythonVersion": "3.11",
      "torchVersion": "2.7.1",
      "torchIndex": "https://download.pytorch.org/whl/cu128",
      "torchPackages": ["torch==2.7.1", "torchvision==0.22.1", "torchaudio==2.7.1"],
      "requirementsFile": "requirements.txt",
      "extraInstalls": [
        {"command": "pip install -e acestep/third_parts/nano-vllm", "description": "Bundled nano-vllm with triton-windows + flash-attn"}
      ],
      "forceTorchReinstall": true,
      "buildSteps": [
        "pip install torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip install -e . --no-deps",
        "pip install -r requirements.txt",
        "pip install -e acestep/third_parts/nano-vllm",
        "pip install --force-reinstall --no-deps torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128"
      ],
      "healthCheck": {
        "endpoint": "/health",
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "startupGraceSeconds": 120
      },
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "ACESTEP_INIT_LLM": "false",
        "ACESTEP_CONFIG_PATH": "acestep-v15-base",
        "ACESTEP_NO_INIT": "true",
        "CAREY_LORA_REGISTRY": "${GARY_RUNTIME}/carey/lora_registry.json",
        "CAREY_CAPTIONS": "${GARY_RUNTIME}/carey/captions.json"
      },
      "dependsOn": []
    },
    {
      "id": "foundation",
      "displayName": "foundation-1",
      "description": "RoyalCities Foundation-1 text-to-sample generation with RC-stable-audio-tools",
      "port": 8015,
      "entryPoint": "api_foundation.py",
      "workingDir": "services/foundation",
      "pythonVersion": "3.11",
      "torchVersion": "2.7.1",
      "torchIndex": "https://download.pytorch.org/whl/cu128",
      "torchPackages": ["torch==2.7.1", "torchaudio==2.7.1", "torchvision==0.22.1"],
      "requirementsFile": "requirements.txt",
      "editableInstall": true,
      "editablePackagePath": "./RC-stable-audio-tools",
      "editableInstallFlags": "--no-deps",
      "forceTorchReinstall": true,
      "buildSteps": [
        "pip install torch==2.7.1 torchaudio==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip install setuptools",
        "pip install -e ./RC-stable-audio-tools --no-deps",
        "pip install -r requirements.txt",
        "pip install https://github.com/sdbds/flash-attention-for-windows/releases/download/2.8.2/flash_attn-2.8.2+cu128torch2.7.1cxx11abiFALSEfullbackward-cp311-cp311-win_amd64.whl",
        "pip install --force-reinstall --no-deps torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128"
      ],
      "healthCheck": {
        "endpoint": "/health",
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "startupGraceSeconds": 180
      },
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "HF_TOKEN": "${HF_TOKEN}",
        "FOUNDATION_MODEL_DIR": "${MODELS_DIR}/foundation-1",
        "FOUNDATION_CKPT_PATH": "${MODELS_DIR}/foundation-1/Foundation_1.safetensors",
        "FOUNDATION_CONFIG_PATH": "${MODELS_DIR}/foundation-1/model_config.json"
      },
      "native": {
        "bundle": "sa3",
        "executable": "sat-server.exe",
        "modelsDir": "foundation",
        "args": ["--model", "foundation-1", "--encoding", "f16"],
        "env": {
          "SA3_PORT": "8015",
          "SA3_DEVICE": "${NATIVE_BACKEND}",
          "SA3_MODELS_DIR": "${MODELS_DIR}/foundation"
        }
      },
      "migration": {
        "dataDir": "foundation",
        "label": "Foundation-1",
        "legacy": {
          "envDirs": ["env", ".venv"],
          "hfRepos": [],
          "staged": {
            "dir": "models/foundation-1",
            "label": "PyTorch model",
            "files": ["Foundation_1.safetensors", "model_config.json"]
          },
          "code": {
            "files": [
              "Dockerfile.reference",
              "api_foundation.py",
              "bpm_range.py",
              "bpm_range_test.py",
              "download_model.py",
              "inference_profiles.py",
              "requirements.lock.txt",
              "requirements.txt",
              "test_inference_profiles.py"
            ],
            "packages": ["RC-stable-audio-tools"]
          }
        }
      },
      "dependsOn": []
    },
    {
      "id": "yuey",
      "displayName": "yuey (yue2)",
      "description": "YuE2 song generation, covers, continuation, and audio-to-MIDI transcription with yuey.cpp",
      "port": 8007,
      "runtime": "native",
      "workingDir": "services/yuey",
      "native": {
        "executable": "yue2-server.exe",
        "modelsDir": "yuey",
        "version": "v0.2.4",
        "platforms": {
          "windows-x64": {
            "core": {
              "url": "https://github.com/betweentwomidnights/yuey.cpp/releases/download/v0.2.4/yuey-v0.2.4-windows-x64-core.zip",
              "sha256": "5175174811e5ffbbc2bb324745b3512fedeac005e8eafddc4ba285cdab359493"
            },
            "backends": {
              "cuda": {
                "url": "https://github.com/betweentwomidnights/yuey.cpp/releases/download/v0.2.4/yuey-v0.2.4-windows-x64-cuda.zip",
                "sha256": "c07a1fad96109874ba53bef435d51793e389bc92c61f3210da36dd8590c60bc1",
                "requires": ["cudart-12.8"]
              },
              "vulkan": {
                "url": "https://github.com/betweentwomidnights/yuey.cpp/releases/download/v0.2.4/yuey-v0.2.4-windows-x64-vulkan.zip",
                "sha256": "d7600536eac3f23f3e239e521a4cdfc22def1ea92c5f91d5b4170fe4e1a80041"
              }
            },
            "prefer": ["cuda", "vulkan"]
          }
        }
      },
      "healthCheck": {
        "endpoint": "/health",
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "startupGraceSeconds": 15
      },
      "env": {
        "YUE2_MODELS_DIR": "${MODELS_DIR}/yuey",
        "YUE2_PORT": "8007",
        "YUE2_DEVICE": "${NATIVE_BACKEND}"
      },
      "dependsOn": []
    }
  ],
  "nativeRuntimes": {
    "cudart-12.8": {
      "url": "https://github.com/betweentwomidnights/gary-localhost-installer/releases/download/runtime-cudart-12.8.1/cudart-12.8.1-windows-x64.zip",
      "sha256": "1d389e513e06eda2b3640160870fa0753c0d32f52439def79353a3c2e69acd97"
    }
  },
  "infrastructure": {},
  "defaults": {
    "pythonVersion": "3.11",
    "modelsDir": "${MODELS_DIR}",
    "logsDir": "${GARY_RUNTIME}/logs",
    "servicesDir": "${SERVICES_DIR}"
  }
}
