  "version": "2.0",
  "services": [
    {
      "id": "gary",
      "displayName": "gary (musicgen)",
      "description": "MusicGen continuation and generation service",
      "port": 8000,
      "entryPoint": "g4l_localhost.py",
      "workingDir": "services/gary",
      "pythonVersion": "3.11",
      "torchVersion": "2.7.1",
      "torchIndex": "https://download.pytorch.org/whl/cu128",
      "torchPackages": ["torch==2.7.1", "torchaudio==2.7.1"],
      "requirementsFile": "requirements.txt",
      "editableInstall": true,
      "editablePackagePath": ".",
      "editableInstallFlags": "--no-deps",
      "xformersShim": true,
      "forceTorchReinstall": true,
      "buildSteps": [
        "pip install torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip install -e . --no-deps",
        "pip install -r requirements.txt",
        "pip install https://github.com/sdbds/flash-attention-for-windows/releases/download/2.8.2/flash_attn-2.8.2+cu128torch2.7.1cxx11abiFALSEfullbackward-cp311-cp311-win_amd64.whl",
        "install_xformers_shim",
        "pip install --force-reinstall --no-deps torch==2.7.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128",
        "pip uninstall torchvision"
      ],
      "healthCheck": {
        "endpoint": "/health",
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "startupGraceSeconds": 60
      },
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONLEGACYWINDOWSSTDIO": "1"
      },
      "native": {
        "bundle": "audiocraft",
        "executable": "musicgen-server.exe",
        "modelsDir": "gary",
        "env": {
          "AC_MUSICGEN_PORT": "8000",
          "AC_DEVICE": "${NATIVE_BACKEND}",
          "AC_MODELS_DIR": "${MODELS_DIR}/gary"
        }
      },
      "migration": {
        "dataDir": "gary",
        "label": "gary",
        "legacy": {
          "envDirs": ["env", ".venv"],
          "hfRepos": [
            {"repo": "thepatch/vanya_ai_dnb_0.1", "label": "PyTorch vanya_ai_dnb_0.1 finetune"},
            {"repo": "thepatch/gary_orchestra_2", "label": "PyTorch gary_orchestra_2 finetune"},
            {"repo": "thepatch/keygen-gary-v2-small-8", "label": "PyTorch keygen-gary-v2-small-8 finetune"},
            {"repo": "thepatch/keygen-gary-v2-small-12", "label": "PyTorch keygen-gary-v2-small-12 finetune"},
            {"repo": "thepatch/bleeps-medium", "label": "PyTorch bleeps-medium finetune"},
            {"repo": "thepatch/keygen-gary-medium-12", "label": "PyTorch keygen-gary-medium-12 finetune"},
            {"repo": "thepatch/hoenn_lofi", "label": "PyTorch hoenn_lofi finetune"},
            {"repo": "thepatch/bleeps-large-6", "label": "PyTorch bleeps-large-6 finetune"},
            {"repo": "thepatch/bleeps-large-8", "label": "PyTorch bleeps-large-8 finetune"},
            {"repo": "thepatch/bleeps-large-10", "label": "PyTorch bleeps-large-10 finetune"},
            {"repo": "thepatch/bleeps-large-14", "label": "PyTorch bleeps-large-14 finetune"},
            {"repo": "thepatch/bleeps-large-20", "label": "PyTorch bleeps-large-20 finetune"},
            {"repo": "thepatch/keygen-gary-v2-large-12", "label": "PyTorch keygen-gary-v2-large-12 finetune"},
            {"repo": "thepatch/keygen-gary-v2-large-16", "label": "PyTorch keygen-gary-v2-large-16 finetune"},
            {"repo": "facebook/encodec_32khz", "label": "PyTorch EnCodec"}
          ],
          "code": {
            "files": [
              "g4l_localhost.py",
              "g4laudio.py",
              "musicgen_fast.py",
              "requirements.lock.txt",
              "requirements.txt",
              "setup.cfg",
              "setup.py"
            ],
            "packages": ["audiocraft"]
          }
        }
      },
      "dependsOn": []
    },
    {
      "id": "melodyflow",
